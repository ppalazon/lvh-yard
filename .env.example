# This Workstation's settings, read by compose.yaml and by the dashboard. Copy to .env and fill in.

# This Workstation's name: unique in the Yard, lowercase letters, digits and -. Also its Consul datacenter's name.
YARD_WORKSTATION=
# The Yard's base domain, the same on every Workstation. Any name under lvh.me resolves to 127.0.0.1 through public
# DNS; use localhost when offline or behind a router that blocks such answers.
YARD_BASE_DOMAIN=lvh.me
# The Yard's gossip key, the same on every Workstation. The first Workstation makes one with:
#   docker run --rm hashicorp/consul:2.1.0 keygen
YARD_GOSSIP_KEY=
# The other Workstations' LAN addresses, separated by spaces, each as <ip> or <ip>:<serf-wan-port>.
YARD_PEERS=
# The LAN address Consul listens on. Empty: the address of the interface with the default route.
YARD_BIND_ADDRESS=
# The address ranges only an Instance's own Workstation can reach, separated by commas. Another Workstation's Instance
# in one is out of range here and gets no Route. Unset: loopback and Docker's bridge networks, 172.17.0.0/16 to
# 172.31.0.0/16. Set it when your LAN uses addresses in 172.17-172.31; set but empty, nothing is out of range.
#YARD_OUT_OF_RANGE=127.0.0.0/8,::1/128,172.17.0.0/16,172.18.0.0/15,172.20.0.0/14,172.24.0.0/13

# Ports. Only the Consul server and serf WAN ports face the LAN; open them to the other Workstations.
YARD_HTTP_PORT=80
YARD_DASHBOARD_PORT=7780
YARD_CONSUL_HTTP_PORT=8500
YARD_CONSUL_DNS_PORT=8600
YARD_CONSUL_GRPC_TLS_PORT=8503
YARD_CONSUL_SERVER_PORT=8300
YARD_CONSUL_SERF_LAN_PORT=8301
YARD_CONSUL_SERF_WAN_PORT=8302
