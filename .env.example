# This Workstation's settings, read by compose.yaml and by the dashboard. Copy to .env and fill in.

# This Workstation's name: unique in the Yard, lowercase letters, digits and -. Also its Consul datacenter's name.
YARD_WORKSTATION=
# This Workstation's base domain, which every hostname it routes ends with. Each Workstation picks its own. Any name
# under lvh.me resolves to 127.0.0.1 through public DNS; use localhost when offline or behind a router that blocks such
# answers.
YARD_BASE_DOMAIN=lvh.me
# The Yard's gossip key, the same on every Workstation. The first Workstation makes one with:
#   docker run --rm hashicorp/consul:2.1.0 keygen
YARD_GOSSIP_KEY=
# The other Workstations' LAN addresses, separated by spaces, each as <ip> or <ip>:<serf-wan-port>.
YARD_PEERS=
# The LAN address Consul listens on. Empty: the address of the interface with the default route.
YARD_BIND_ADDRESS=
# The address ranges only an Instance's own Workstation can reach, separated by commas. Another Workstation's Instance
# in one is out of range here and gets no Route. Unset: loopback and Docker's bridge networks, 172.17.0.0/16 to
# 172.31.0.0/16. Set it when your LAN uses addresses in 172.17-172.31; set but empty, nothing is out of range.
#YARD_OUT_OF_RANGE=127.0.0.0/8,::1/128,172.17.0.0/16,172.18.0.0/15,172.20.0.0/14,172.24.0.0/13

# The IPv4 addresses Traefik and the dashboard listen on. 127.0.0.1 by default: only this computer reaches them. 0.0.0.0
# listens on every address, loopback included; any other address listens there only. Traefik on an address
# without loopback breaks the hostnames under lvh.me here, as they resolve to 127.0.0.1. The dashboard has no login: on
# another address, whoever reaches it can change this Workstation's Services and, through the Docker socket, its
# containers.
YARD_TRAEFIK_BIND_ADDRESS=127.0.0.1
YARD_DASHBOARD_BIND_ADDRESS=127.0.0.1

# Only for the dashboard from its image (COMPOSE_PROFILES=dashboard). It runs as this user and group, not root, with
# the group that owns the Docker socket added so it can read it. YARD_DOCKER_GID has no default: it differs on each
# computer. The values: id -u, id -g, and stat -c %g /var/run/docker.sock.
#YARD_UID=1000
#YARD_GID=1000
#YARD_DOCKER_GID=
# Starts the dashboard from its image with `docker compose up -d`, for a Workstation without Java; lvh-yard init sets
# it. Leave it commented to run the dashboard from the sources with `mise run dashboard`.
#COMPOSE_PROFILES=dashboard

# Ports. Only the Consul server and serf WAN ports face the LAN; open them to the other Workstations.
YARD_HTTP_PORT=80
# Traefik's admin page and its ping, on 127.0.0.1 only, whatever YARD_TRAEFIK_BIND_ADDRESS says.
YARD_TRAEFIK_ADMIN_PORT=8080
YARD_DASHBOARD_PORT=7780
YARD_CONSUL_HTTP_PORT=8500
YARD_CONSUL_DNS_PORT=8600
YARD_CONSUL_GRPC_TLS_PORT=8503
YARD_CONSUL_SERVER_PORT=8300
YARD_CONSUL_SERF_LAN_PORT=8301
YARD_CONSUL_SERF_WAN_PORT=8302
