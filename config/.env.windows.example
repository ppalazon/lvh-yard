# The settings of this Workstation. compose.yaml and the dashboard read them. Copy this file to .env and fill it in.

# The name of this Workstation. It is also the name of its Consul datacenter.
# It is unique in the Yard. Use lowercase letters, digits and -.
YARD_WORKSTATION=
# The Base Domain of this Workstation. Each hostname it routes ends with it. Each Workstation picks its own.
# Public DNS resolves each name under lvh.me to 127.0.0.1.
# If you are offline, or your router blocks such answers, use localhost.
YARD_BASE_DOMAIN=lvh.me
# The shared Gossip Key of the Yard. lvh-yard ws init makes one for a new Workstation.
# ws yard standalone makes a new one.
# To open this Workstation to a Yard: lvh-yard ws tls ca create, then lvh-yard ws yard init.
# To invite another Workstation: lvh-yard ws yard share <name>.
# The other Workstation runs: lvh-yard ws yard join <zip file>.
YARD_GOSSIP_KEY=
# The LAN addresses of the other Workstations, separated by spaces or commas.
# Write each one as <ip>, <ip>:<serf-wan-port> or [<ipv6>]:<serf-wan-port>.
YARD_PEERS=
# The native Windows LAN IPv4 address that Consul advertises to the other Workstations. lvh-yard ws init sets it.
# Consul listens on 0.0.0.0 inside Docker Desktop. This is not the address it binds.
YARD_BIND_ADDRESS=
# The host that the other Workstations use to reach the Instances of this Workstation.
# A Static Instance without --host gets it too. If it is empty, it is YARD_BIND_ADDRESS.
YARD_INSTANCE_HOST=
# The address ranges that only the own Workstation of an Instance can reach, separated by commas.
# An Instance of another Workstation in one of these ranges gets no Route.
# If it is not set, the ranges are loopback and the Docker bridge networks, 172.17.0.0/16 to 172.31.0.0/16.
# If your LAN uses addresses in 172.17-172.31, set it.
# If it is set but empty, no address is out of range.
#YARD_OUT_OF_RANGE=127.0.0.0/8,::1/128,172.17.0.0/16,172.18.0.0/15,172.20.0.0/14,172.24.0.0/13

# The IPv4 addresses that Traefik and the dashboard listen on.
#   - 127.0.0.1: only this computer reaches them.
#   - 0.0.0.0: every address, loopback too.
#   - Windows accepts only these two.
# If Traefik does not listen on loopback, the hostnames under lvh.me do not work here. They resolve to 127.0.0.1.
# The dashboard has no login. If it listens on another address, anyone who reaches it can do this:
# change the Services of this Workstation, and its containers through the Docker socket.
YARD_TRAEFIK_BIND_ADDRESS=127.0.0.1
YARD_DASHBOARD_BIND_ADDRESS=127.0.0.1
# Whether this Workstation runs Traefik. lvh-yard ws set traefik on|off also changes its Compose profile.
YARD_TRAEFIK_ENABLED=true

# If a request to the dashboard fails, its log shows one line. Set true to log the stack trace too.
#YARD_STACK_TRACES=true

# Windows Compose runs Consul and the dashboard as 1000:1000.
# The dashboard also joins group 0 to read the Docker Desktop socket.
# These three settings do nothing on Windows. Leave them commented out.
#YARD_UID=1000
#YARD_GID=1000
#YARD_DOCKER_GID=
# Starts the dashboard and Traefik with docker compose up -d. lvh-yard ws init sets it.
# To run the dashboard from the sources, keep only the traefik profile.
#COMPOSE_PROFILES=dashboard,traefik

# The ports. Only the Consul server port and the serf WAN port face the LAN. Open them to the other Workstations.
YARD_HTTP_PORT=80
# Empty until HTTPS is on. lvh-yard ws tls https create|import sets it.
YARD_HTTPS_PORT=
# Whether Traefik asks for the Client Certificate of a person, and whether it shows its own certificate to Services.
# lvh-yard ws tls client and lvh-yard ws tls mtls set them.
YARD_CLIENT_AUTH_ENABLED=false
YARD_MTLS_ENABLED=false
# The admin page and the ping of Traefik. They are on 127.0.0.1 only, whatever YARD_TRAEFIK_BIND_ADDRESS says.
YARD_TRAEFIK_ADMIN_PORT=8080
YARD_DASHBOARD_PORT=7780
YARD_CONSUL_HTTP_PORT=8500
YARD_CONSUL_DNS_PORT=8600
YARD_CONSUL_GRPC_TLS_PORT=8503
YARD_CONSUL_SERVER_PORT=8300
YARD_CONSUL_SERF_LAN_PORT=8301
YARD_CONSUL_SERF_WAN_PORT=8302
