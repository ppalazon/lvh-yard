<?xml version="1.0" encoding="UTF-8"?>
<project child.project.url.inherit.append.path="false" xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>
    <groupId>dev.palazon</groupId>
    <artifactId>lvh-yard</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>lvh-yard</name>
    <description>Predictable hostnames for development services on every Workstation in a Yard</description>
    <!-- Each element below replaces what the Spring Boot parent would pass down: its url, Spring as developer, its scm. -->
    <url>https://github.com/ppalazon/lvh-yard</url>
    <inceptionYear>2026</inceptionYear>
    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>ppalazon</id>
            <name>Pablo Palazon</name>
            <url>https://github.com/ppalazon</url>
        </developer>
    </developers>
    <scm child.scm.url.inherit.append.path="false"
         child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false">
        <url>https://github.com/ppalazon/lvh-yard</url>
        <connection>scm:git:https://github.com/ppalazon/lvh-yard.git</connection>
        <developerConnection>scm:git:git@github.com:ppalazon/lvh-yard.git</developerConnection>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/ppalazon/lvh-yard/issues</url>
    </issueManagement>

    <!-- The two modules share no code: the dashboard's openapi.yaml is their contract. -->
    <modules>
        <module>dashboard</module>
        <module>cli</module>
    </modules>

    <properties>
        <!-- The version of both modules. A release sets it from its tag: -Drevision=0.1.0 -->
        <revision>0.0.1-SNAPSHOT</revision>
        <java.version>25</java.version>
        <maven-toolchains-plugin.version>3.2.0</maven-toolchains-plugin.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>${maven-toolchains-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>select-jdk-toolchain</goal>
                        </goals>
                        <configuration>
                            <!-- The Java 25 guard: compile, test and run on a JDK 25 whatever JDK runs Maven, and fail the build if none is found. -->
                            <version>[${java.version},26)</version>
                            <useJdk>Never</useJdk>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- requireJavaVersion only sees the JVM running Maven, so it can set a floor but not pin 25; the toolchain above does that. -->
                                <requireJavaVersion>
                                    <version>[${java.version},)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
