# The .env of test Workstation ws-b, the second of two Workstations on this computer. Its pages: http://yard.localhost:8081
# Both Workstations listen on loopback only, so this committed gossip key guards nothing. Use your own key in a real Yard.

YARD_WORKSTATION=ws-b
# Each Workstation picks its own Base Domain. Each name under localhost resolves to this computer.
YARD_BASE_DOMAIN=localhost
YARD_GOSSIP_KEY=eUs7jAdJHAfhNlzlLnxMhxI9isP2SUDkT+2V/vJiIVY=
YARD_PEERS=127.0.0.1:8302
YARD_BIND_ADDRESS=127.0.0.1
# Both Workstations share the loopback of this computer, so an Instance of ws-a there is in range.
YARD_OUT_OF_RANGE=172.17.0.0/16,172.18.0.0/15,172.20.0.0/14,172.24.0.0/13

YARD_TRAEFIK_BIND_ADDRESS=127.0.0.1
YARD_DASHBOARD_BIND_ADDRESS=127.0.0.1

# Each port is the port of ws-a plus 10, but Traefik is on 8081 and its admin page on 8090.
YARD_HTTP_PORT=8081
YARD_TRAEFIK_ADMIN_PORT=8090
YARD_DASHBOARD_PORT=7781
YARD_CONSUL_HTTP_PORT=8510
YARD_CONSUL_DNS_PORT=8610
YARD_CONSUL_GRPC_TLS_PORT=8513
YARD_CONSUL_SERVER_PORT=8310
YARD_CONSUL_SERF_LAN_PORT=8311
YARD_CONSUL_SERF_WAN_PORT=8312
