# The .env of test Workstation ws-a, the first of two Workstations on this computer. Its pages: http://yard.lvh.me:10080
# Both Workstations listen on loopback only, so this committed gossip key guards nothing. Use your own key in a real Yard.

YARD_WORKSTATION=ws-a
YARD_BASE_DOMAIN=lvh.me
YARD_GOSSIP_KEY=eUs7jAdJHAfhNlzlLnxMhxI9isP2SUDkT+2V/vJiIVY=
YARD_PEERS=127.0.0.1:18312
YARD_BIND_ADDRESS=127.0.0.1
# Both Workstations share the loopback of this computer, so an Instance of ws-b there is in range.
YARD_OUT_OF_RANGE=172.17.0.0/16,172.18.0.0/15,172.20.0.0/14,172.24.0.0/13

YARD_TRAEFIK_BIND_ADDRESS=127.0.0.1
YARD_DASHBOARD_BIND_ADDRESS=127.0.0.1

# Each port is the default port plus 10000, so a real Workstation on this computer keeps the defaults.
YARD_HTTP_PORT=10080
YARD_TRAEFIK_ADMIN_PORT=18080
YARD_DASHBOARD_PORT=17780
YARD_CONSUL_HTTP_PORT=18500
YARD_CONSUL_DNS_PORT=18600
YARD_CONSUL_GRPC_TLS_PORT=18503
YARD_CONSUL_SERVER_PORT=18300
YARD_CONSUL_SERF_LAN_PORT=18301
YARD_CONSUL_SERF_WAN_PORT=18302
