# A Yard of two Workstations on this one computer, for trying out federation: `mise run dev:up`.
# Both listen on loopback only, so this committed gossip key guards nothing. Use your own key in a real Yard.
YARD_BASE_DOMAIN=lvh.me
YARD_GOSSIP_KEY=eUs7jAdJHAfhNlzlLnxMhxI9isP2SUDkT+2V/vJiIVY=
YARD_BIND_ADDRESS=127.0.0.1
# Both Workstations share this computer's loopback, so another Workstation's Instance there is in range.
YARD_OUT_OF_RANGE=172.17.0.0/16,172.18.0.0/15,172.20.0.0/14,172.24.0.0/13
