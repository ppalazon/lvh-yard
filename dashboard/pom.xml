<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.palazon</groupId>
        <artifactId>lvh-yard</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>dashboard</artifactId>
    <name>dashboard</name>
    <description>The LVH Yard on one Workstation: web pages, REST API and Traefik's routes</description>

    <properties>
        <!-- HtmlFlow 5.2.0 is compiled for Java 17 and has no Spring integration: views render to a String. -->
        <htmlflow.version>5.2.0</htmlflow.version>
        <htmx.version>4.0.0</htmx.version>
        <!-- springdoc 3.x is the line for Spring Boot 4. 3.1.x is built against Boot 4.1. -->
        <springdoc.version>3.1.1</springdoc.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <!-- The version Testcontainers uses, so the tests and the dashboard share one Docker transport. -->
        <docker-java.version>3.7.1</docker-java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- The OpenAPI document of the REST API, at /v3/api-docs. openapi.yaml is its committed copy. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.xmlet</groupId>
            <artifactId>htmlflow</artifactId>
            <version>${htmlflow.version}</version>
        </dependency>
        <!-- Served at /webjars/... without a version in the path, through webjars-locator-lite. -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>htmx.org</artifactId>
            <version>${htmx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>webjars-locator-lite</artifactId>
        </dependency>
        <!-- Only the core circuit breaker: the Yard reader builds its own, so no Spring Boot starter is needed. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <!-- Spring Boot reads application.yaml with it, and sets its version. The tests read YAML with it too. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <!-- Only the HTTP transport to the Docker socket: the container watcher reads the Engine API's JSON itself. -->
        <dependency>
            <groupId>com.github.docker-java</groupId>
            <artifactId>docker-java-transport-zerodep</artifactId>
            <version>${docker-java.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Unit and component tests (*Test) run with surefire. Integration tests (*IT) run with failsafe: docs/adr/0008. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Each JVM has its own dashboards and fakes, so test classes run side by side. -->
                    <forkCount>4</forkCount>
                    <systemPropertyVariables>
                        <spring.main.banner-mode>off</spring.main.banner-mode>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- Each JVM starts its own test Yard of containers. More than four was not faster. -->
                    <forkCount>4</forkCount>
                    <systemPropertyVariables>
                        <spring.main.banner-mode>off</spring.main.banner-mode>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
