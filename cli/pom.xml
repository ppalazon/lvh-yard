<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.palazon</groupId>
        <artifactId>lvh-yard</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>cli</artifactId>
    <name>cli</name>
    <description>The lvh-yard command: talks to the dashboard on its own Workstation</description>

    <properties>
        <picocli.version>4.7.7</picocli.version>
        <wiremock.version>3.13.1</wiremock.version>
        <nativeimage.version>25.0.2</nativeimage.version>
        <templating-maven-plugin.version>3.1.1</templating-maven-plugin.version>
        <main.class>dev.palazon.lvhyard.cli.Yard</main.class>
        <!-- The -O level of native-image: 2 is its default. -->
        <native.optimization>2</native.optimization>
    </properties>

    <!-- No Spring: a command starts in a fraction of a second. The parent only manages versions. -->
    <dependencies>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <!-- The REST API's JSON. HTTP itself is the JDK's HttpClient. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- NativeRecords' API, which native-image itself provides when it builds the lvh-yard executable. -->
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>nativeimage</artifactId>
            <version>${nativeimage.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The stub dashboard, and openapi.yaml read to keep its answers to the contract. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Version.java, with the pom's version written in, from src/main/java-templates. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>templating-maven-plugin</artifactId>
                <version>${templating-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>filter-sources</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- lvh-yard init's templates are the repository's own compose.yaml and .env.example, copied in at
                 each build so they cannot drift. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>init-templates</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/templates</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/..</directory>
                                    <includes>
                                        <include>compose.yaml</include>
                                        <include>.env.example</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- picocli-codegen lists every command's options for the native image, which cannot find them by reflection. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
                        <!-- No proxy-config.json: no command is an interface, so it is empty, and native-image
                             warns that its format is deprecated. -->
                        <arg>-Adisable.proxy.config</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- One runnable jar holding picocli too: java -jar cli/target/cli-*.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- Replaces the Spring Boot parent's transformers, which merge Spring files this jar has none of. -->
                            <transformers combine.self="override">
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Unit and component tests (*Test) run with surefire. Integration tests (*IT) run with failsafe: docs/adr/0008. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The lvh-yard command as one executable, with no Java needed to run it: mise run native, or
             ./mvnw -Pnative -pl cli verify with GraalVM's native-image on GRAALVM_HOME. The Spring Boot parent's own
             native profile sets up the plugin. -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>lvh-yard</imageName>
                            <mainClass>${main.class}</mainClass>
                            <buildArgs>
                                <buildArg>--features=dev.palazon.lvhyard.cli.NativeRecords</buildArg>
                                <buildArg>-O${native.optimization}</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                    <!-- The tests again, against the executable: a class the native image cannot reach by reflection
                         fails here, not on a user's machine. Runs in verify: ./mvnw -Pnative -pl cli verify -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>test-native</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <configuration>
                                    <reportsDirectory>${project.build.directory}/surefire-reports-native</reportsDirectory>
                                    <systemPropertyVariables>
                                        <yard.executable>${project.build.directory}/lvh-yard</yard.executable>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <yard.executable>${project.build.directory}/lvh-yard</yard.executable>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
