# The settings of this Workstation. compose.yaml and the dashboard read them. Copy this file to .env and fill it in.

# The name of this Workstation, also the name of its Consul datacenter. It is unique in the Yard. Use lowercase letters,
# digits and -.
YARD_WORKSTATION=
# The Base Domain of this Workstation. Each hostname that it routes ends with it. Each Workstation picks its own. Public
# DNS resolves each name under lvh.me to 127.0.0.1. If you are offline, or your router blocks such answers, use
# localhost.
YARD_BASE_DOMAIN=lvh.me
# The Yard's shared Gossip Key. lvh-yard ws init makes one for a new Yard.
# To invite another Workstation, run lvh-yard ws yard share on a member.
YARD_GOSSIP_KEY=
# The LAN addresses of the other Workstations, separated by spaces or commas. Write each one as <ip>,
# <ip>:<serf-wan-port> or [<ipv6>]:<serf-wan-port>.
YARD_PEERS=
# The LAN address that Consul listens on. If it is empty, Consul uses the address of the interface with the default
# route.
YARD_BIND_ADDRESS=
# The address ranges that only the own Workstation of an Instance can reach, separated by commas. An Instance of another
# Workstation in one of these ranges is out of range here, and gets no Route. If this is not set, the ranges are
# loopback and the Docker bridge networks, 172.17.0.0/16 to 172.31.0.0/16. If your LAN uses addresses in
# 172.17-172.31, set it. If it is set but empty, no address is out of range.
#YARD_OUT_OF_RANGE=127.0.0.0/8,::1/128,172.17.0.0/16,172.18.0.0/15,172.20.0.0/14,172.24.0.0/13

# The IPv4 addresses that Traefik and the dashboard listen on. With 127.0.0.1, only this computer reaches them. 0.0.0.0
# listens on every address, loopback too. Any other address listens only there.
# If Traefik does not listen on loopback, the hostnames under lvh.me do not work here, because they resolve to
# 127.0.0.1.
# The dashboard has no login. If it listens on another address, anyone who reaches it can change the Services of this
# Workstation, and its containers through the Docker socket.
YARD_TRAEFIK_BIND_ADDRESS=127.0.0.1
YARD_DASHBOARD_BIND_ADDRESS=127.0.0.1
# Whether this Workstation runs Traefik. lvh-yard ws set traefik on|off also changes its Compose profile.
YARD_TRAEFIK_ENABLED=true

# If a request to the dashboard fails, its log shows one line. Set this to true to also log the stack trace.
#YARD_STACK_TRACES=true

# Only for the dashboard image (COMPOSE_PROFILES=dashboard). The dashboard runs as this user and group, not as root. It
# also joins the group that owns the Docker socket, so that it can read the socket. YARD_DOCKER_GID has no default,
# because it differs on each computer. To find the values, run id -u, id -g and stat -c %g /var/run/docker.sock.
#YARD_UID=1000
#YARD_GID=1000
#YARD_DOCKER_GID=
# Starts the dashboard and Traefik with docker compose up -d. lvh-yard ws init sets it.
# To run the dashboard from the sources, keep only the traefik profile.
#COMPOSE_PROFILES=dashboard,traefik

# The ports. Only the Consul server port and the serf WAN port face the LAN. Open them to the other Workstations.
YARD_HTTP_PORT=80
# Empty until a Workstation Certificate is imported.
YARD_HTTPS_PORT=
# The admin page and the ping of Traefik. They are on 127.0.0.1 only, whatever YARD_TRAEFIK_BIND_ADDRESS says.
YARD_TRAEFIK_ADMIN_PORT=8080
YARD_DASHBOARD_PORT=7780
YARD_CONSUL_HTTP_PORT=8500
YARD_CONSUL_DNS_PORT=8600
YARD_CONSUL_GRPC_TLS_PORT=8503
YARD_CONSUL_SERVER_PORT=8300
YARD_CONSUL_SERF_LAN_PORT=8301
YARD_CONSUL_SERF_WAN_PORT=8302
