# The local graph cache of graft. `graft build` makes it again, so it is not committed.
/graft/

# Maven build output
target/

# Each Workstation's settings and the Yard's gossip key
.env

# The Route Profiles of a Workstation that runs from the sources
/route-profiles.yaml
/dev/*.route-profiles.yaml

# IDE files
.classpath
.project
.settings/
.idea/
*.iml
.vscode/

# CSS build tools, installed by `mise run css:install`, and the stylesheet they build
node_modules/
/dashboard/src/main/resources/static/app.css
