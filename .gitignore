# The local graph cache of graft. `graft build` makes it again, so it is not committed.
/graft/

# Maven build output
target/

# Each Workstation's settings and the Yard's gossip key
.env
/dev/ws-a/
/dev/ws-b/

# The Backups of the test Workstations and of a dashboard image run from this folder. They hold basic-auth hashes.
/dev/backups/
/backups/

# IDE files
.classpath
.project
.settings/
.idea/
*.iml
.vscode/

# CSS build tools, installed by `mise run css:install`, and the stylesheet they build
node_modules/
/dashboard/src/main/resources/static/app.css

# Local tool settings: absolute paths of one machine, and agent worktrees and locks
/.omp/
/.claude/settings.local.json
/.claude/worktrees/
/.claude/scheduled_tasks.lock

# The built landing page
/docs/site/dist/
